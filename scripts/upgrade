#!/bin/bash

source /usr/share/yunohost/helpers

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

ynh_setup_source --dest_dir="$install_dir" --source_id="ynh_build" --full_replace=1 --keep="tools-filter.json home.custom.md"

#Prepare $newpath for string replacement (empty if $path is root or $path if subdir is defined)
newpath=""
if [[ $path != '/' ]]; then newpath=$path; fi

# Replace placeholders
ynh_replace --match="/__YNH_PATH__/" --replace="$newpath/" --file="$install_dir/index.html"
ynh_replace --match="https://sharevb-it-tools.vercel.app" --replace="https://$domain$path" --file="$install_dir/index.html"

#=================================================
# REINSTALL DEPENDENCIES 
#=================================================
ynh_script_progression "Reinstall dependencies..."

# Puppeteer HTML to PDF server
ynh_setup_source --dest_dir="$install_dir/puppeteer-htmltopdf" --source_id="puppeteer-htmltopdf"
pushd "$install_dir/puppeteer-htmltopdf"
    ynh_hide_warnings ynh_exec_as_app npm install 
popd
ynh_config_add --template=".env" --destination="$install_dir/puppeteer-htmltopdf/.env"

# Network utilies server
ynh_setup_source --dest_dir="$install_dir/network-utilities" --source_id="network-utilities"
pushd "$install_dir/network-utilities"
    ynh_hide_warnings ynh_exec_as_app "venv/bin/pip" install --upgrade pip
    ynh_hide_warnings ynh_exec_as_app "venv/bin/pip" install -r "$install_dir/network-utilities/requirements.txt"
    ynh_safe_rm ".cache/pip"
popd

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

# Create a dedicated systemd config
ynh_config_add_systemd --service="$app-puppeteer"
yunohost service add "$app-puppeteer" --description="IT-Tools Puppeteer server for HTML to PDF conversion" --log="/var/log/$app/$app-puppeteer.log"

ynh_config_add_systemd --service="$app-uvicorn" --template="network-utils.service"
yunohost service add "$app-uvicorn" --description="IT-Tools Uvicorn server for network utilities" --log="/var/log/$app/$app-uvicorn.log"

# Use logrotate to manage application logfile(s)
ynh_config_add_logrotate

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
